# Banda Nova York · página de links em app.bandanovayork.com.br · gerado por scripts/build-links.py --app (não editar à mão)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 default
AddDefaultCharset utf-8
AddType image/webp .webp
AddType font/woff2 .woff2
AddType image/svg+xml .svg
RedirectMatch 404 ^/(?!\.well-known/)\.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://app.bandanovayork.com.br%{REQUEST_URI} [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+api/videos\.php[\s?] [NC]
  RewriteRule ^ - [R=404,L]
  RewriteRule ^api/videos/?$ api/videos.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-TS9E1qV083yuqoyjeeoWCUuTneWOiGUC27QyAl68EUA='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; media-src 'self'; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; manifest-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
